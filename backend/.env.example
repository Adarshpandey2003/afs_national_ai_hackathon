DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# Writer (reasoning on). Clarifier, researcher and OCR use FAST_LLM_MODEL.
LLM_MODEL=deepseek-v4-pro
FAST_LLM_MODEL=deepseek-flash
# Max writer rewrites after a failed critic review
MAX_REVISIONS=2
# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173
# Fallback search of peer-reviewed abstracts (OpenAlex) when the AFS knowledge base lacks a point: on | off
WEB_SEARCH=on
# Writer model in interactive (live UI) mode; batch mode uses LLM_MODEL
INTERACTIVE_WRITER_MODEL=deepseek-flash
# Login + per-user history (optional; without these the app runs without login). Supabase -> Settings -> API
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional free OpenAlex key (https://openalex.org/rest-api); anonymous paper search can be rate-limited
OPENALEX_API_KEY=
